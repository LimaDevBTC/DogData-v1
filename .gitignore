app/api/city/

# DogCity Luna (real lunar terrain) — WIP, not for production.
# Imports `astronomy-engine`, which is held back from the committed
# package.json via `git update-index --skip-worktree` (kept local-only).
# Untracked here so the auto-commit bot can't sweep it into a deploy again.
app/city/luna/
lib/city/lunar/
scripts/lunar/

