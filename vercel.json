{
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api/dog-rune/:path*",  "destination": "/api/index.js" },
    { "source": "/api/airdrop/:path*",   "destination": "/api/index.js" },
    { "source": "/api/forensic/:path*",  "destination": "/api/index.js" },
    { "source": "/api/price/:path*",     "destination": "/api/index.js" },
    { "source": "/api/health",           "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/update-transactions?secret=dog-update-secret",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/dog-rune/holders?snapshot=refresh",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/stacks/snapshot",
      "schedule": "0 * * * *"
    },
    {
      "path": "/cron/whale-poster",
      "schedule": "*/5 * * * *"
    }
  ]
}
